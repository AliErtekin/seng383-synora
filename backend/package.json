{
  "name": "synora-backend",
  "version": "0.0.0",
  "private": true,
  "description": "SYNORA backend: Express API with SQLite",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
